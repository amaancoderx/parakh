# Copy this file to .env and fill in the values. .env is gitignored.

# Required: every OpenAI system in the comparison, and the harness itself.
OPENAI_API_KEY=

# Optional recognisers. A system appears in the comparison table only when its key is set.
SARVAM_API_KEY=
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
